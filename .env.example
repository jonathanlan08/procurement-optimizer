# Example environment file for local development.
#
# Copy to `.env` in the repo root (or `backend/.env` - pydantic-settings reads
# `.env` from the process working directory) and adjust as needed:
#
#   cp .env.example .env
#
# All settings are read by backend/src/app/core/config.py::Settings, which uses
# the `PO_` env prefix. Nothing here is a real secret; these are the values that
# match the services defined in docker-compose.yml. Never commit a real `.env`
# (it is gitignored) or paste real secrets into this file.

# --- Core ---

# dev | test | prod. Controls error verbosity, docs exposure, and cookie Secure
# flag. Never set to `prod` outside a real deployment.
PO_ENVIRONMENT=dev

# SQLAlchemy URL. Matches the `postgres` service in docker-compose.yml
# (POSTGRES_DB=procurement, POSTGRES_USER=postgres, POSTGRES_PASSWORD=postgres).
PO_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/procurement

# Hours before a session cookie expires.
PO_SESSION_TTL_HOURS=12

# Signs session/CSRF material. The default is a clearly-fake dev value; the app
# refuses to start with this value when PO_ENVIRONMENT=prod. Generate a real
# secret for any non-dev deployment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
PO_SECRET_KEY=dev-only-secret-change-me

# Force the `Secure` flag on cookies. Automatically forced true in prod
# regardless of this value; only relevant for dev/test.
PO_COOKIE_SECURE=false

# pydantic-settings parses list-typed fields from env vars as a JSON array.
# Default matches the Vite dev server port.
PO_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Uploads and rate limiting ---

# 20 MiB default.
PO_MAX_UPLOAD_BYTES=20971520

PO_RATE_LIMIT_PER_MINUTE=120
PO_RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Provider selection ---
# mock/template providers require no external services or keys and are the
# default for local development and tests.

# mock | anthropic
PO_EXTRACTION_PROVIDER=mock

# mock (only supported value today)
PO_OCR_PROVIDER=mock

# template | anthropic
PO_NARRATIVE_PROVIDER=template

# filesystem | s3
PO_STORAGE_PROVIDER=filesystem

# inline | thread
PO_JOB_RUNNER=thread

# Filesystem storage root, used when PO_STORAGE_PROVIDER=filesystem (default).
# Gitignored; safe to leave as-is locally.
PO_STORAGE_ROOT=.local-storage

# Enables demo conveniences (e.g. API docs stay on in prod). Seeding is done
# explicitly via scripts/seed_demo.py; there is no reset endpoint in this build.
PO_DEMO_MODE=true

# --- Optional: Anthropic provider ---
# Required only if PO_EXTRACTION_PROVIDER=anthropic or PO_NARRATIVE_PROVIDER=anthropic.
# Absent + either provider set to `anthropic` => the app refuses to start
# (fail-fast, never silently falls back to mock).
# PO_ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: S3 / MinIO storage provider ---
# Required only if PO_STORAGE_PROVIDER=s3. Values below match the `minio`
# service in docker-compose.yml (MINIO_ROOT_USER=minioadmin,
# MINIO_ROOT_PASSWORD=minioadmin, API port 9000).
# PO_STORAGE_PROVIDER=s3
# PO_S3_ENDPOINT_URL=http://localhost:9000
# PO_S3_BUCKET=procurement-documents
# PO_S3_ACCESS_KEY=minioadmin
# PO_S3_SECRET_KEY=minioadmin
